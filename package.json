{
  "name": "markovmade",
  "version": "1.0.0",
  "private": true,
  "description": "MARKOVMADE static product site and browser QA suite",
  "scripts": {
    "optimize:images": "node scripts/optimize-local-images.cjs && node scripts/build-image-variants.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:a11y": "node tests/accessibility.cjs",
    "test:visual": "node tests/e2e.cjs",
    "test:ci": "npm test && npm run test:e2e && npm run test:a11y"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "pixelmatch": "^5.3.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0"
  }
}
