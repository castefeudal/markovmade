{
  "name": "markovmade",
  "version": "1.0.0",
  "private": true,
  "description": "MARKOVMADE static product site and browser QA suite",
  "scripts": {
    "build": "node scripts/build.cjs",
    "optimize:images": "node scripts/optimize-local-images.cjs && node scripts/build-image-variants.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/e2e.cjs && node tests/toolkit-browser.cjs",
    "test:a11y": "node tests/accessibility.cjs",
    "test:visual": "node tests/product-contracts.cjs",
    "test:paint": "node tests/streaming-paint.cjs",
    "test:ci": "npm run build && npm test && npm run test:e2e && npm run test:a11y && npm run test:visual && npm run test:paint",
    "serve": "node scripts/serve.cjs",
    "test:lighthouse": "node scripts/lighthouse.cjs",
    "test:production": "node tests/production-smoke.cjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.3",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "pixelmatch": "^5.3.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28"
  }
}
